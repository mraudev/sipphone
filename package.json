{
  "name": "sipphone",
  "productName": "SIP Phone",
  "version": "1.24.0",
  "private": true,
  "description": "SIP-Softphone als Desktop-App",
  "author": "Michael Rau",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "de.rau.sipphone",
    "files": [
      "src/**",
      "public/**",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/opusscript/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mraudev",
        "repo": "sipphone",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIP Phone",
      "uninstallDisplayName": "SIP Phone",
      "runAfterFinish": true,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "artifactName": "SIP-Phone-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SIP-Phone-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "synopsis": "SIP-Softphone",
      "maintainer": "Michael Rau <dev@mraudev.com>"
    },
    "appImage": {
      "artifactName": "SIP-Phone-${version}.${ext}"
    },
    "deb": {
      "artifactName": "sip-phone_${version}_${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "opusscript": "^0.0.8"
  }
}
